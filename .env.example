# Copy to .env for local development. Everything here matches docker-compose.yml.

DATABASE_URL=postgres://iam:iam@localhost:5432/iam
CONNECTIONS_DATABASE_URL=postgres://iam_connections:iam_connections@localhost:5432/iam_connections

DYNAMO_ENDPOINT=http://localhost:8001
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# WebAuthn relying-party identity. WARNING: passkeys are scoped to IAM_RP_ID and
# do NOT migrate between domains. localhost is for development only — pick the
# production domain before the first real registration.
IAM_RP_ID=localhost
IAM_RP_ORIGIN=http://localhost:8080
IAM_RP_NAME=iam

# Token signing. Generate values with: cargo run -p iam-api --bin keygen
# Rotation: add a new kid to "keys", deploy, flip "active", retire the old kid later.
# All listed kids verify; only "active" signs.
# NOTE: single-quoted so dotenvy keeps the JSON literal (it strips double quotes
# from unquoted values).
IAM_SIGNING_KEYS='{"active":"dev1","keys":{"dev1":"REPLACE_WITH_KEYGEN_OUTPUT"}}'

# 32-byte base64 key for encrypting outbound connection secrets (iam-connections
# database). Separate from signing keys by design; keygen prints one.
IAM_CONNECTIONS_ENC_KEY=REPLACE_WITH_KEYGEN_OUTPUT

IAM_ISSUER=http://localhost:8080
IAM_AUDIENCE=cuffney-ecosystem
IAM_TOKEN_TTL_SECS=900
IAM_SESSION_TTL_SECS=43200

IAM_LISTEN_ADDR=127.0.0.1:8080
RUST_LOG=info,iam_api=debug
